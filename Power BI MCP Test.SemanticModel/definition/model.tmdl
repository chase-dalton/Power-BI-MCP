model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

	relationship a0000001-0000-0000-0000-000000000001
		fromColumn: fact_chart_position.date_id
		toColumn: dim_date.date_id

	relationship a0000002-0000-0000-0000-000000000002
		fromColumn: fact_chart_position.chart_id
		toColumn: dim_chart.chart_id

	relationship a0000003-0000-0000-0000-000000000003
		fromColumn: fact_chart_position.song_id
		toColumn: dim_song.song_id

	relationship a0000004-0000-0000-0000-000000000004
		fromColumn: fact_chart_position.artist_id
		toColumn: dim_artist.artist_id

	relationship a0000005-0000-0000-0000-000000000005
		fromColumn: dim_song.artist_id
		toColumn: dim_artist.artist_id
		isActive: false

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode"]

ref cultureInfo en-US

table dim_date
	lineageTag: t0000001-0000-0000-0000-000000000001

	column date_id
