		lineageTag: c0000001-0004-0000-0000-000000000001
		summarizeBy: none

	column month_name
		dataType: string
		lineageTag: c0000001-0005-0000-0000-000000000001
		summarizeBy: none

	column quarter
		dataType: int64
		lineageTag: c0000001-0006-0000-0000-000000000001
		summarizeBy: none

	column year
		dataType: int64
		lineageTag: c0000001-0007-0000-0000-000000000001
		summarizeBy: none

	partition dim_date = m
		mode: import
		source = ```
			let
			    Source = PostgreSQL.Database("localhost", "billboard", [CreateNavigationProperties=false]),
			    nav    = Source{[Schema="public", Item="dim_date"]}[Data]
			in
			    nav
			```

